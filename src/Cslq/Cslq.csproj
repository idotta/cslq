<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>cslq</AssemblyName>
    <RootNamespace>Cslq</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
  </ItemGroup>

  <!-- The pure logic below the LSP transport - sentinel inference, argument parsing, path
       and URI rendering - is unit-tested. Everything that needs a live server stays in
       probes/. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Cslq.Tests" />
  </ItemGroup>

</Project>
