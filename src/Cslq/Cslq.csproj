<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>cslq</AssemblyName>
    <RootNamespace>Cslq</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Every wire this program writes is source-generated: the language server's
         payloads, the session's own RPC, and the JSON output mode. Declaring the assembly
         AOT-compatible turns the trim and AOT analysers on, and TreatWarningsAsErrors
         then makes a reflective serializer a build failure rather than a warning nobody
         reads. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- [LibraryImport]'s generated marshalling stubs are unsafe by construction. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cslq</ToolCommandName>
    <PackageId>cslq</PackageId>
    <Version>0.3.0</Version>
    <Authors>iuri dotta</Authors>
    <Description>Semantic C# queries over the official roslyn-language-server, for coding agents.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/idotta/cslq</RepositoryUrl>
    <PackageProjectUrl>https://github.com/idotta/cslq</PackageProjectUrl>
    <PackageTags>roslyn;lsp;csharp;dotnet-tool;coding-agent;cli</PackageTags>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <!-- Normalises the paths SourceLink embeds, so a package built by release.yml is
         reproducible. Conditioned on the runner's own variable rather than set outright:
         a local dotnet pack keeps its absolute paths and stays debuggable. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' != ''">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
  </ItemGroup>

  <!-- The server pin travels with the tool. ServerArgs.ToolManifestRoot walks up from
       AppContext.BaseDirectory, which for an installed tool is this same
       tools/net10.0/any/ directory, so the walk finds the manifest on its first step and
       LspClient runs the server there. Without this an installed binary cannot resolve the
       pin at all - there is no repository above it. -->
  <ItemGroup>
    <None Include="../../.config/dotnet-tools.json" Pack="true" PackagePath="tools/net10.0/any/.config/" />
  </ItemGroup>

  <!-- The nuget.org readme. It is its own file rather than README.md because every link on a
       nuget.org page has to be absolute - relative ones render dead there. -->
  <ItemGroup>
    <None Include="../../PACKAGE.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- The pure logic below the LSP transport - sentinel inference, argument parsing, path
       and URI rendering - is unit-tested. Everything that needs a live server stays in
       probes/. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Cslq.Tests" />
  </ItemGroup>

</Project>
